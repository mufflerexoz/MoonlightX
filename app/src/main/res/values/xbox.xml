<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MoonlightX palette: dark UI with white highlights -->
    <color name="xbox_green">#107C10</color>
    <color name="xbox_dark_grey">#121212</color>
    <color name="xbox_highlight">#40FFFFFF</color>
    <color name="xbox_text_secondary">#8C8C8C</color>
    <color name="xbox_launch_spinner">#7AB8BD</color>

    <!-- View tag key used by XboxUi to remember a grid's original side padding -->
    <item name="xbox_base_padding" type="id" />

    <dimen name="xbox_screen_padding">48dp</dimen>
    <dimen name="xbox_header_button">48dp</dimen>
    <dimen name="xbox_tile_size">230dp</dimen>
    <dimen name="xbox_tile_spacing">20dp</dimen>
    <dimen name="xbox_app_tile_width">200dp</dimen>
    <dimen name="xbox_app_tile_height">300dp</dimen>

    <string name="xbox_app_title" translatable="false">Moonlight</string>
    <string name="xbox_app_title_x" translatable="false">X</string>
    <string name="xbox_settings">Settings</string>
    <string name="xbox_help">Help</string>
    <string name="xbox_add_pc">Add PC</string>
    <string name="xbox_back">Back</string>
    <string name="xbox_background_title">MoonlightX background</string>
    <string name="xbox_background_dashboard">XBOX Dashboard</string>
    <string name="xbox_background_grey">Dark Grey</string>
    <string name="xbox_mod_credit">Version %1$s · MoonlightX mod by mufflerexoz</string>
    <string name="xbox_launch_title">Initializing Moonlight…</string>
    <string name="xbox_launch_app">Starting \'%1$s\'</string>
    <!-- Controller tips shown under the game list (matching Moonlight for Android's real combos) -->
    <string name="xbox_shortcuts_html"><![CDATA[<b>Useful Shortcuts:</b> hold Menu to toggle mouse mode · Menu+View for the Guide/Xbox button · Menu+View+LB+RB to quit the stream<br><b>In Mouse mode:</b> Ⓐ Left click &#160; Ⓑ Right click &#160; D-pad Scroll &#160; Sticks Move pointer]]></string>

    <!-- Square rounded header button (Add PC, Settings, Back) -->
    <style name="XboxHeaderButton">
        <item name="android:layout_width">@dimen/xbox_header_button</item>
        <item name="android:layout_height">@dimen/xbox_header_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/xbox_header_button</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="XboxHeaderTitle">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
