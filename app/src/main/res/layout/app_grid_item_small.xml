<?xml version="1.0" encoding="utf-8"?>
<!-- Game tile: portrait box art with the game name underneath.
     A white rounded outline marks the highlighted tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="210dp"
    android:background="@drawable/xbox_tile"
    android:orientation="vertical"
    android:padding="10dp"
    android:stateListAnimator="@animator/xbox_tile_state">

    <FrameLayout
        android:id="@+id/grid_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cropToPadding="false"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Shown by the art loader only when there is no box art -->
        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
