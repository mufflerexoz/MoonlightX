<?xml version="1.0" encoding="utf-8"?>
<!-- Game tiles, centered horizontally and vertically. The list selector is disabled because the highlighted
     tile draws its own white outline. -->
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:numColumns="auto_fit"
    android:columnWidth="@dimen/xbox_app_tile_width"
    android:stretchMode="none"
    android:horizontalSpacing="@dimen/xbox_tile_spacing"
    android:verticalSpacing="@dimen/xbox_tile_spacing"
    android:paddingLeft="@dimen/xbox_screen_padding"
    android:paddingRight="@dimen/xbox_screen_padding"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:listSelector="@android:color/transparent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@id/backButton"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"/>
