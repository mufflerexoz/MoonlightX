<?xml version="1.0" encoding="utf-8"?>
<!-- Game tiles, centered. The list selector is disabled because the highlighted
     tile draws its own white outline. -->
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:numColumns="auto_fit"
    android:columnWidth="140dp"
    android:stretchMode="none"
    android:horizontalSpacing="14dp"
    android:verticalSpacing="14dp"
    android:paddingLeft="@dimen/xbox_screen_padding"
    android:paddingRight="@dimen/xbox_screen_padding"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:listSelector="@android:color/transparent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@id/backButton"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"/>
