<!-- Home: logo + "Moonlight" on the left, square Add/Settings buttons on the right,
     PC tiles centered on the screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PcView" >

    <LinearLayout
        android:id="@+id/xboxHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/xbox_screen_padding"
        android:paddingRight="@dimen/xbox_screen_padding"
        android:paddingTop="28dp">

        <include layout="@layout/xbox_header_logo" />

        <LinearLayout
            android:id="@+id/xboxTitleBlock"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <!-- "Moonlight[X]" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xbox_app_title"
                    style="@style/XboxHeaderTitle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/xbox_x_badge"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="@string/xbox_app_title_x"
                    android:textColor="@color/xbox_dark_grey"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:contentDescription="@string/xbox_add_pc"
                android:src="@drawable/ic_xbox_plus"
                android:preferKeepClear="true"
                style="@style/XboxHeaderButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/settingsButton"
                android:contentDescription="@string/xbox_settings"
                android:src="@drawable/ic_xbox_settings"
                android:preferKeepClear="true"
                style="@style/XboxHeaderButton" />
        </LinearLayout>

        <!-- Not shown in this design; kept so the existing Help code keeps working -->
        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/xbox_help"
            android:visibility="gone" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingLeft="@dimen/xbox_screen_padding"
            android:paddingRight="@dimen/xbox_screen_padding">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/xbox_launch_spinner"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="16dp"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#FFFFFF"
                android:text="@string/searching_pc"/>
        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>
